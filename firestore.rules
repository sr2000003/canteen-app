rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins - readable by any logged-in user, never writable from client
    match /admins/{phoneNumber} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Employees - anyone logged in can read; users can only create their own record
    match /employees/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Orders - anyone logged in can read; users can only create orders for themselves
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Config - anyone logged in can read; only admins can write
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.phone_number));
    }
  }
}
